@page
@model LoginModel
@{ ViewData["Title"] = "Log in"; }
<div class="row justify-content-center"><div class="col-md-5">
    <h2>Log in</h2>
    <form method="post">
        <input type="hidden" asp-for="Next" />
        <div class="mb-3"><label class="form-label">Username</label><input asp-for="Username" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">Password</label><input asp-for="Password" type="password" class="form-control" required /></div>
        <button class="btn btn-primary">Log in</button>
        <a asp-page="/Register" asp-route-next="@Model.Next" class="ms-2">Create a passenger account</a>
    </form>
</div></div>
