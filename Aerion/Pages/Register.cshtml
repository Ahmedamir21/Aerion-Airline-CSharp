@page
@model RegisterModel
@{ ViewData["Title"] = "Sign up"; }
<div class="row justify-content-center"><div class="col-md-6">
    <h2>Create a passenger account</h2>
    <form method="post">
        <input type="hidden" asp-for="Next" />
        <div class="mb-3"><label class="form-label">Full name</label><input asp-for="Name" class="form-control" required maxlength="100" /></div>
        <div class="row">
            <div class="col mb-3"><label class="form-label">Username</label><input asp-for="Username" class="form-control" required /></div>
            <div class="col mb-3"><label class="form-label">Passport number</label><input asp-for="Passport" class="form-control" required /></div>
        </div>
        <div class="mb-3"><label class="form-label">Contact (optional)</label><input asp-for="Contact" class="form-control" /></div>
        <div class="row">
            <div class="col mb-3"><label class="form-label">Password</label><input asp-for="Password" type="password" class="form-control" required /></div>
            <div class="col mb-3"><label class="form-label">Confirm password</label><input asp-for="Confirm" type="password" class="form-control" required /></div>
        </div>
        <button class="btn btn-primary">Sign up</button>
    </form>
</div></div>
