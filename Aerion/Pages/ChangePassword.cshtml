@page
@model ChangePasswordModel
@{ ViewData["Title"] = "Change password"; }
<div class="row justify-content-center"><div class="col-md-5">
    <h2>Change password</h2>
    <form method="post">
        <div class="mb-3"><label class="form-label">Current password</label><input asp-for="Current" type="password" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">New password</label><input asp-for="NewPassword" type="password" class="form-control" required /></div>
        <div class="mb-3"><label class="form-label">Confirm new password</label><input asp-for="Confirm" type="password" class="form-control" required /></div>
        <button class="btn btn-primary">Save</button>
    </form>
</div></div>
