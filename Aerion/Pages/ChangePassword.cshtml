@page
@model ChangePasswordModel
@{ ViewData["Title"] = "Change password"; }
<div class="section-panel narrow-panel">
    <h2><i class="fas fa-key"></i> Change password</h2>
    <form method="post" autocomplete="off">
        <div class="form-group">
            <label for="current">Current password</label>
            <div class="pw-field">
                <input asp-for="Current" id="current" type="password" required autocomplete="current-password" />
                <button type="button" class="pw-toggle" aria-label="Show password" aria-pressed="false"><i class="fas fa-eye"></i></button>
            </div>
        </div>
        <div class="form-group">
            <label for="new">New password</label>
            <div class="pw-field">
                <input asp-for="NewPassword" id="new" type="password" required minlength="8" autocomplete="new-password" />
                <button type="button" class="pw-toggle" aria-label="Show password" aria-pressed="false"><i class="fas fa-eye"></i></button>
            </div>
        </div>
        <div class="form-group">
            <label for="confirm">Confirm new password</label>
            <div class="pw-field">
                <input asp-for="Confirm" id="confirm" type="password" required minlength="8" autocomplete="new-password" />
                <button type="button" class="pw-toggle" aria-label="Show password" aria-pressed="false"><i class="fas fa-eye"></i></button>
            </div>
        </div>
        <p class="help-text">At least 8 characters.</p>
        <button type="submit" class="btn-submit">Save</button>
    </form>
</div>
