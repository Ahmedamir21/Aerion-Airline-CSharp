@page
@model MyBagsModel
@{ ViewData["Title"] = "My bags"; }
@functions {
    private static string BadgeClass(string status) => status switch
    {
        "lost" => "status-cancelled",
        "delayed" => "status-delayed",
        _ => "status-scheduled"
    };
}
<div class="section-panel">
    <h2><i class="fas fa-suitcase-rolling"></i> My bags</h2>
    <table>
        <thead><tr><th>Tag</th><th>Flight</th><th>Seat</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var b in Model.Bags)
        {
            <tr>
                <td>@b.Tag</td><td>@b.Flight</td><td>@b.Seat</td>
                <td><span class="status-badge @BadgeClass(b.Status)">@b.Status</span></td>
                <td>
                    @if (b.Status is "checked in" or "loaded" or "delayed")
                    {
                        <form method="post" asp-page-handler="Lost" asp-route-id="@b.Id" class="inline-form">
                            <button type="submit" class="btn-small btn-danger">Report lost</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
