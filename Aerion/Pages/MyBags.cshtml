@page
@model MyBagsModel
@{ ViewData["Title"] = "My bags"; }
<h2>My bags</h2>
<table class="table align-middle"><thead><tr><th>Tag</th><th>Flight</th><th>Seat</th><th>Status</th><th></th></tr></thead><tbody>
@foreach (var b in Model.Bags)
{
 <tr><td>@b.Tag</td><td>@b.Flight</td><td>@b.Seat</td><td><span class="badge bg-@(b.Status == "lost" ? "danger" : b.Status == "delayed" ? "warning" : "secondary")">@b.Status</span></td>
 <td>@if (b.Status is "checked in" or "loaded" or "delayed") { <form method="post" asp-page-handler="Lost" asp-route-id="@b.Id"><button class="btn btn-outline-danger btn-sm">Report lost</button></form> }</td></tr>
}
</tbody></table>
