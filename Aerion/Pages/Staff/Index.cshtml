@page
@model Aerion.Pages.Staff.IndexModel
@{ ViewData["Title"] = "Counter"; }
<div class="section-panel">
    <h2><i class="fas fa-id-badge"></i> Counter</h2>
    <form method="get" class="toolbar">
        <div class="form-group">
            <label for="q">Booking number or passenger name</label>
            <input id="q" name="q" value="@Model.Q" />
        </div>
        <button type="submit" class="btn-primary">Find booking</button>
        <a class="btn-secondary" asp-page="/Search">Book for a passenger</a>
    </form>

    @if (Model.Rows.Count > 0)
    {
        <table>
            <thead><tr><th>Booking</th><th>Passenger</th><th>Flight</th><th>Departs</th><th>Seat</th><th>Ticket</th><th>Bag</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td>#@r.BookingId</td><td>@r.Passenger</td><td>@r.Flight</td><td>@r.Dep.ToString("dd MMM HH:mm")</td><td>@r.Seat</td>
                    <td>
                        <div class="cell-actions">
                            <span>@r.Status</span>
                            @if (r.Status == "issued" && r.BookingStatus == "confirmed")
                            {
                                <form method="post" asp-page-handler="CheckIn" class="inline-form">
                                    <input type="hidden" name="ticketId" value="@r.TicketId" /><input type="hidden" name="q" value="@Model.Q" />
                                    <button type="submit" class="btn-small">Check in</button>
                                </form>
                            }
                            @if (r.Status != "cancelled")
                            {
                                <form method="post" asp-page-handler="MoveSeat" class="inline-form">
                                    <input type="hidden" name="ticketId" value="@r.TicketId" /><input type="hidden" name="q" value="@Model.Q" />
                                    <input name="seat" size="4" placeholder="12A" aria-label="New seat" />
                                    <button type="submit" class="btn-small">Move</button>
                                </form>
                            }
                        </div>
                    </td>
                    <td>
                        @if (r.BagId != null)
                        {
                            <form method="post" asp-page-handler="Bag" class="inline-form">
                                <input type="hidden" name="bagId" value="@r.BagId" /><input type="hidden" name="q" value="@Model.Q" />
                                <span>@r.BagTag</span>
                                <input name="weight" size="4" placeholder="kg" aria-label="Weight in kg" />
                                <select name="status" aria-label="Bag status"><option>checked in</option><option>loaded</option><option>delayed</option><option>lost</option><option>delivered</option></select>
                                <button type="submit" class="btn-small">Save</button>
                            </form>
                            <span class="status-badge status-scheduled">@r.BagStatus</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
