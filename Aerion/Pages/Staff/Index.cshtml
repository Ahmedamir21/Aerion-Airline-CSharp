@page
@model Aerion.Pages.Staff.IndexModel
@{ ViewData["Title"] = "Counter"; }
<h2>Counter</h2>
<form method="get" class="row g-2 mb-3">
    <div class="col-md-6"><input name="q" value="@Model.Q" class="form-control" placeholder="Booking number or passenger name" /></div>
    <div class="col-auto"><button class="btn btn-primary">Find booking</button></div>
    <div class="col-auto"><a class="btn btn-outline-primary" asp-page="/Search">Book for a passenger</a></div>
</form>
@if (Model.Rows.Count > 0)
{
<table class="table align-middle"><thead><tr><th>Booking</th><th>Passenger</th><th>Flight</th><th>Departs</th><th>Seat</th><th>Ticket</th><th>Bag</th></tr></thead><tbody>
@foreach (var r in Model.Rows)
{
 <tr>
  <td>#@r.BookingId</td><td>@r.Passenger</td><td>@r.Flight</td><td>@r.Dep.ToString("dd MMM HH:mm")</td><td>@r.Seat</td>
  <td>@r.Status
   @if (r.Status == "issued" && r.BookingStatus == "confirmed")
   {
    <form method="post" asp-page-handler="CheckIn" class="d-inline"><input type="hidden" name="ticketId" value="@r.TicketId" /><input type="hidden" name="q" value="@Model.Q" /><button class="btn btn-success btn-sm">Check in</button></form>
   }
   @if (r.Status != "cancelled")
   {
    <form method="post" asp-page-handler="MoveSeat" class="d-inline-flex gap-1"><input type="hidden" name="ticketId" value="@r.TicketId" /><input type="hidden" name="q" value="@Model.Q" /><input name="seat" class="form-control form-control-sm" style="width:70px" placeholder="12A" /><button class="btn btn-outline-secondary btn-sm">Move</button></form>
   }
  </td>
  <td>
   @if (r.BagId != null)
   {
    <form method="post" asp-page-handler="Bag" class="d-inline-flex gap-1">
     <input type="hidden" name="bagId" value="@r.BagId" /><input type="hidden" name="q" value="@Model.Q" />
     <span class="me-1">@r.BagTag</span>
     <input name="weight" class="form-control form-control-sm" style="width:70px" placeholder="kg" />
     <select name="status" class="form-select form-select-sm"><option>checked in</option><option>loaded</option><option>delayed</option><option>lost</option><option>delivered</option></select>
     <button class="btn btn-outline-secondary btn-sm">Save</button>
    </form>
    <span class="badge bg-secondary">@r.BagStatus</span>
   }
  </td>
 </tr>
}
</tbody></table>
}
