@page
@model Aerion.Pages.Staff.FlightStatusModel
@{ ViewData["Title"] = "Flight status"; }
<div class="section-panel">
    <h2><i class="fas fa-plane-departure"></i> Flight status</h2>
    <table>
        <thead><tr><th>Flight</th><th>Route</th><th>Departs</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var f in Model.Flights)
        {
            <tr>
                <td><strong>@f.Number</strong></td><td>@f.Route</td><td>@f.Dep.ToString("dd MMM HH:mm")</td>
                <td>
                    <form method="post" asp-page-handler="Status" class="inline-form">
                        <input type="hidden" name="id" value="@f.Id" />
                        <select name="status">@foreach (var s in new[] { "on time", "delayed", "cancelled" }) { <option selected="@(f.Status == s)">@s</option> }</select>
                        <button type="submit" class="btn-small">Save</button>
                    </form>
                </td>
                <td><a asp-page="/Staff/FlightStatus" asp-route-list="@f.Id">Passenger list</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if (Model.List != null)
{
    <div class="section-panel">
        <h2><i class="fas fa-users"></i> Passenger list</h2>
        <table>
            <thead><tr><th>Name</th><th>Passport</th><th>Seat</th><th>Ticket</th></tr></thead>
            <tbody>
            @foreach (var p in Model.Passengers) { <tr><td>@p.Name</td><td>@p.Passport</td><td>@p.Seat</td><td>@p.Status</td></tr> }
            </tbody>
        </table>
    </div>
}
