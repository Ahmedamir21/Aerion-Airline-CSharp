@page
@model PassengerProfileModel
@{ ViewData["Title"] = "Passenger profile"; }
<div class="auth-container">
    <aside class="auth-aside">
        <i class="fas fa-plane"></i>
        <h2>Fly with Aerion.</h2>
        <p>Staff and admins can book and travel like passengers, with @Model.Discount% off every seat.</p>
    </aside>
    <div class="auth-box">
        <div class="auth-header"><h2>Passenger profile</h2></div>
        <p class="help-text">Booking as <strong>@Model.DisplayName</strong>. This is added to your existing account, so you keep one login.</p>
        <form method="post" class="auth-form" autocomplete="off">
            <div class="form-group">
                <label for="passport">Passport number</label>
                <input asp-for="Passport" id="passport" required maxlength="20" autofocus />
            </div>
            <div class="form-group">
                <label for="contact">Phone or email <small>(optional)</small></label>
                <input asp-for="Contact" id="contact" maxlength="200" />
            </div>
            <button type="submit" class="btn-submit">Create profile</button>
        </form>
    </div>
</div>
