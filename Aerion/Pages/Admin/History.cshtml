@page
@model Aerion.Pages.Admin.HistoryModel
@{ ViewData["Title"] = "History"; }
<div class="section-panel">
    <h2><i class="fas fa-clock-rotate-left"></i> Bookings and cancellations</h2>
    <form method="get" class="toolbar">
        <div class="form-group">
            <label for="status">Status</label>
            <select id="status" name="status">
                <option value="">All</option>
                <option value="confirmed" selected="@(Model.Status == "confirmed")">Confirmed</option>
                <option value="cancelled" selected="@(Model.Status == "cancelled")">Cancelled</option>
            </select>
        </div>
        <button type="submit" class="btn-primary">Filter</button>
    </form>
    <table>
        <thead><tr><th>#</th><th>Passenger</th><th>Flight</th><th>Booked</th><th>Amount</th><th>Status</th><th>Made by</th></tr></thead>
        <tbody>
        @foreach (var r in Model.Rows)
        {
            <tr><td>@r.Id</td><td>@r.Passenger</td><td>@r.Flight</td><td>@r.Booked.ToString("dd MMM yyyy HH:mm")</td><td>$@r.Amount.ToString("N2")</td><td>@r.Status</td><td>@r.By</td></tr>
        }
        </tbody>
    </table>
</div>
