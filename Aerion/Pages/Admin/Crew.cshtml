@page
@model Aerion.Pages.Admin.CrewModel
@{ ViewData["Title"] = "Crew"; }
<h2>Crew assignment</h2>
<form method="get" class="d-flex gap-2 mb-3"><select name="flightId" class="form-select w-auto">@foreach (var f in Model.Flights) { <option value="@f.Id" selected="@(Model.FlightId == f.Id)">@f.Text</option> }</select><button class="btn btn-primary">Open</button></form>
@if (Model.FlightId != null)
{
 <h5>On this flight</h5>
 <ul>@foreach (var c in Model.Assigned) { <li>@c.Name (@c.Role) <form method="post" asp-page-handler="Remove" class="d-inline"><input type="hidden" name="flightId" value="@Model.FlightId" /><input type="hidden" name="crewId" value="@c.Id" /><button class="btn btn-link btn-sm text-danger">remove</button></form></li> }</ul>
 <h5>Available</h5>
 <ul>@foreach (var c in Model.Available) { <li>@c.Name (@c.Role) <form method="post" asp-page-handler="Add" class="d-inline"><input type="hidden" name="flightId" value="@Model.FlightId" /><input type="hidden" name="crewId" value="@c.Id" /><button class="btn btn-link btn-sm">assign</button></form></li> }</ul>
}
