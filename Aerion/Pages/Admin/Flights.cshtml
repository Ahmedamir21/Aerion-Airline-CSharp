@page
@model Aerion.Pages.Admin.FlightsModel
@{ ViewData["Title"] = "Flights"; }
<div class="section-panel">
    <h2><i class="fas fa-plane"></i> @(Model.EditId == null ? "Add a flight" : "Edit flight")</h2>
    <form method="post">
        <input type="hidden" asp-for="EditId" />
        <div class="form-group">
            <label for="route">Route</label>
            <select asp-for="RouteId" id="route">@foreach (var r in Model.Routes) { <option value="@r.Id">@r.Text</option> }</select>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="aircraft">Aircraft</label>
                <select asp-for="AircraftId" id="aircraft" disabled="@(Model.EditId != null)">@foreach (var a in Model.Aircraft) { <option value="@a.Id">@a.Text (@a.Seats seats)</option> }</select>
            </div>
            <div class="form-group">
                <label for="number">Flight number</label>
                <input asp-for="FlightNumber" id="number" />
            </div>
        </div>
        <div class="form-row">
            <div class="form-group"><label for="dep">Departure</label><input asp-for="Departure" id="dep" type="datetime-local" /></div>
            <div class="form-group"><label for="arr">Arrival</label><input asp-for="Arrival" id="arr" type="datetime-local" /></div>
        </div>
        <button type="submit" class="btn-primary">Save</button>
    </form>
</div>
<div class="section-panel">
    <h2><i class="fas fa-list"></i> All flights</h2>
    <table>
        <thead><tr><th>Flight</th><th>Route</th><th>Departs</th><th>Arrives</th><th>Aircraft</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var f in Model.Flights)
        {
            <tr>
                <td><strong>@f.Number</strong></td><td>@f.Route</td><td>@f.Dep.ToString("dd MMM HH:mm")</td><td>@f.Arr.ToString("dd MMM HH:mm")</td>
                <td>@f.Plane</td><td><span class="status-badge @AppPage.StatusClass(f.Status)">@f.Status</span></td>
                <td><a class="btn-small" asp-page="/Admin/Flights" asp-route-edit="@f.Id">Edit</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
