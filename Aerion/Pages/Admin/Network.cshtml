@page
@model Aerion.Pages.Admin.NetworkModel
@{ ViewData["Title"] = "Network"; }
<div class="section-panel">
    <h2><i class="fas fa-location-dot"></i> Airports</h2>
    <form method="post" asp-page-handler="Airport" class="toolbar">
        <div class="form-group"><label for="code">Code</label><input id="code" name="code" maxlength="3" /></div>
        <div class="form-group"><label for="aname">Airport name</label><input id="aname" name="name" /></div>
        <div class="form-group"><label for="city">City</label><input id="city" name="city" /></div>
        <div class="form-group"><label for="country">Country</label><input id="country" name="country" /></div>
        <button type="submit" class="btn-primary">Add airport</button>
    </form>
    <p class="muted">@string.Join(", ", Model.Airports.Select(a => a.Text))</p>
</div>
<div class="section-panel">
    <h2><i class="fas fa-route"></i> Routes</h2>
    <form method="post" asp-page-handler="Route" class="toolbar">
        <div class="form-group"><label for="from">From</label><select id="from" name="from">@foreach (var a in Model.Airports) { <option value="@a.Id">@a.Text</option> }</select></div>
        <div class="form-group"><label for="to">To</label><select id="to" name="to">@foreach (var a in Model.Airports) { <option value="@a.Id">@a.Text</option> }</select></div>
        <div class="form-group"><label for="km">Distance (km)</label><input id="km" name="km" type="number" /></div>
        <div class="form-group"><label for="fare">Base fare ($)</label><input id="fare" name="fare" type="number" step="0.01" /></div>
        <button type="submit" class="btn-primary">Add route</button>
    </form>
    <table>
        <thead><tr><th>Route</th><th>Km</th><th>Economy fare</th></tr></thead>
        <tbody>@foreach (var r in Model.Routes) { <tr><td>@r.Route</td><td>@r.Km</td><td>$@r.Fare.ToString("N0")</td></tr> }</tbody>
    </table>
</div>
<div class="section-panel">
    <h2><i class="fas fa-plane"></i> Aircraft</h2>
    <form method="post" asp-page-handler="Aircraft" class="toolbar">
        <div class="form-group"><label for="reg">Registration</label><input id="reg" name="reg" /></div>
        <div class="form-group"><label for="model">Model</label><input id="model" name="model" /></div>
        <div class="form-group"><label for="seats">Seats</label><input id="seats" name="seats" type="number" /></div>
        <button type="submit" class="btn-primary">Add aircraft</button>
    </form>
    <table>
        <tbody>@foreach (var a in Model.Aircraft) { <tr><td>@a.Reg</td><td>@a.Model</td><td>@a.Seats seats</td></tr> }</tbody>
    </table>
</div>
