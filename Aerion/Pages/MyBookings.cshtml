@page
@model MyBookingsModel
@{ ViewData["Title"] = "My bookings"; }
<div class="section-panel">
    <h2><i class="fas fa-ticket"></i> Upcoming</h2>
    @if (Model.Upcoming.Count == 0)
    {
        <div class="no-upcoming"><i class="fas fa-plane"></i><p>No upcoming bookings.</p><a asp-page="/Search" class="btn-primary">Find a flight</a></div>
    }
    else
    {
        <table>
            <thead><tr><th>Booking</th><th>Flight</th><th>Route</th><th>Departs</th><th>Seat</th><th>Paid</th><th></th></tr></thead>
            <tbody>
            @foreach (var b in Model.Upcoming)
            {
                <tr>
                    <td>#@b.Id</td><td>@b.Flight</td><td>@b.Route</td>
                    <td>@b.Dep.ToString("ddd dd MMM, HH:mm")</td><td>@b.Seat</td><td>$@b.Paid.ToString("N2")</td>
                    <td>
                        <div class="cell-actions">
                            <a class="btn-small" asp-page="/MyBookings" asp-route-changeTicket="@b.TicketId">Change seat</a>
                            <form method="post" asp-page-handler="Cancel" asp-route-id="@b.Id" class="inline-form" onsubmit="return confirm('Cancel this booking?')">
                                <button type="submit" class="btn-small btn-danger">Cancel</button>
                            </form>
                        </div>
                    </td>
                </tr>
                @if (Model.ChangeTicket == b.TicketId)
                {
                    <tr>
                        <td colspan="7">
                            <form method="post" asp-page-handler="Change" class="inline-form">
                                <input type="hidden" name="ticketId" value="@b.TicketId" />
                                <select name="seat">@foreach (var s in Model.FreeSeats) { <option>@s</option> }</select>
                                <button type="submit" class="btn-primary btn-small">Move me here</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    }
</div>
<div class="section-panel">
    <h2><i class="fas fa-clock-rotate-left"></i> History</h2>
    <table>
        <thead><tr><th>Booking</th><th>Flight</th><th>Route</th><th>Date</th><th>Seat</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var b in Model.Past)
        {
            <tr><td>#@b.Id</td><td>@b.Flight</td><td>@b.Route</td><td>@b.Dep.ToString("dd MMM yyyy")</td><td>@b.Seat</td><td>@b.Status</td></tr>
        }
        </tbody>
    </table>
</div>
