@{
    string? role = Context.Session.GetString("role");
    string? message = (string?)TempData["err"] ?? (string?)TempData["ok"];
    string kind = TempData["err"] != null ? "error" : "success";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aerion</title>
    <script>
        (function () {
            try {
                var t = localStorage.getItem('theme');
                if (!t) { t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
                document.documentElement.setAttribute('data-theme', t);
            } catch (e) {}
        })();
    </script>
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <nav class="main-nav">
        <div class="nav-container">
            <a asp-page="/Index" class="nav-logo"><i class="fas fa-plane"></i><span>Aerion</span></a>
            <ul class="nav-links">
                @switch (role)
                {
                    case "admin":
                        <li><a asp-page="/Admin/Index">Dashboard</a></li>
                        <li><a asp-page="/Admin/Users">Users</a></li>
                        <li><a asp-page="/Admin/Reports">Reports</a></li>
                        break;
                    case "staff":
                        <li><a asp-page="/Staff/Index">Counter</a></li>
                        <li><a asp-page="/Staff/FlightStatus">Flight status</a></li>
                        <li><a asp-page="/Search">Book for passenger</a></li>
                        break;
                    case "passenger":
                        <li><a asp-page="/Search">Search flights</a></li>
                        <li><a asp-page="/MyBookings">My bookings</a></li>
                        <li><a asp-page="/MyBags">My bags</a></li>
                        <li><a asp-page="/Account">Miles</a></li>
                        break;
                    default:
                        <li><a asp-page="/Index">Home</a></li>
                        <li><a asp-page="/Register">Sign Up</a></li>
                        break;
                }
                @if (role == null)
                {
                    <li><a asp-page="/Login" class="nav-cta">Sign in</a></li>
                }
                else
                {
                    <li><a asp-page="/ChangePassword">Password</a></li>
                    <li>
                        <form method="post" asp-page="/Logout" class="nav-form">
                            <button type="submit" class="nav-cta">Log out</button>
                        </form>
                    </li>
                }
                <li class="theme-toggle-container">
                    <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle theme"><i class="fas fa-moon"></i></button>
                </li>
            </ul>
        </div>
    </nav>
    <main class="container">
        @if (message != null)
        {
            <div class="toasts" role="status" aria-live="polite">
                <div class="toast toast-@kind"><span>@message</span><button type="button" class="toast-x" aria-label="Dismiss">&times;</button></div>
            </div>
        }
        @RenderBody()
    </main>

    <footer>
        <div class="footer-container">
            <div class="footer-bottom"><p>&copy; 2026 Aerion. CSAI 202 Project.</p></div>
        </div>
    </footer>

    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script defer src="~/js/main.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
