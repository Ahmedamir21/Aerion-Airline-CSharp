@{
    string? role = Context.Session.GetString("role");
    string? name = Context.Session.GetString("name");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aerion</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark aerion-nav">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Index">Aerion</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="nav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link" asp-page="/Search">Search flights</a></li>
                        @if (role == "passenger")
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/MyBookings">My bookings</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/MyBags">My bags</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Account">Miles</a></li>
                        }
                        @if (role == "staff")
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Staff/Index">Counter</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Staff/FlightStatus">Flight status</a></li>
                        }
                        @if (role == "admin")
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Index">Admin</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Admin/Reports">Reports</a></li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (role == null)
                        {
                            <li class="nav-item"><a class="nav-link" asp-page="/Register">Sign up</a></li>
                            <li class="nav-item"><a class="btn btn-light btn-sm ms-2" asp-page="/Login">Log in</a></li>
                        }
                        else
                        {
                            <li class="nav-item"><span class="navbar-text me-2">@name (@role)</span></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/ChangePassword">Change password</a></li>
                            <li class="nav-item">
                                <form method="post" asp-page="/Logout"><button class="btn btn-outline-light btn-sm ms-2">Log out</button></form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    <footer class="text-center text-muted small py-4">
        Aerion Airline Management - CSAI 202 course project
    </footer>

    @if (TempData["ok"] != null || TempData["err"] != null)
    {
        <div class="toast-container position-fixed bottom-0 start-50 translate-middle-x p-3">
            <div class="toast align-items-center text-bg-@(TempData["err"] != null ? "danger" : "success") border-0 show" role="alert">
                <div class="d-flex">
                    <div class="toast-body">@(TempData["err"] ?? TempData["ok"])</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        </div>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
