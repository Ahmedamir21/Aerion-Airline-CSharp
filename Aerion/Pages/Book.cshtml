@page "{id:int}"
@model BookModel
@{ ViewData["Title"] = "Select seats"; }
<div class="seat-page">
<h2>Select seats</h2>
<p class="text-muted">@Model.FlightNumber &middot; @Model.RouteText &middot; @Model.Dep.ToString("ddd dd MMM yyyy, HH:mm") &middot; @Model.Model</p>
<p>Price per seat: <strong>Business $@Model.Business.ToString("N2")</strong> &middot; <strong>Economy $@Model.Economy.ToString("N2")</strong></p>
<div class="row">
 <div class="col-lg-8">
  <div class="plane" id="plane">
   @foreach (var cabin in Model.Cabins)
   {
    @if (cabin.Name == "Economy") { <div class="cabin-divider"><span>Economy cabin starts here</span></div> }
    <div class="cabin-@cabin.Name.ToLower()">
     <div class="cabin-title">@cabin.Name class @(cabin.Name == "Business" ? "(wide seats, extra legroom, double miles)" : "")</div>
     @foreach (var row in cabin.Rows)
     {
      <div class="seat-row @(Model.ExitRows.Contains(row.Number) ? "exit" : "")">
       <span class="row-no">@row.Number</span>
       @foreach (var group in row.Groups)
       {
        <div class="seat-group">
         @foreach (var s in group)
         {
          decimal price = cabin.Name == "Business" ? Model.Business : Model.Economy;
          <button type="button" class="seat @(Model.Taken.Contains(s) ? "taken" : "")" data-seat="@s" data-price="@price" disabled="@Model.Taken.Contains(s)">@s.Last()</button>
         }
        </div>
       }
       <span class="row-no">@row.Number</span>
      </div>
     }
    </div>
   }
  </div>
 </div>
 <div class="col-lg-4"><div class="card p-3 summary">
  <h5>Your booking</h5>
  <ul id="sel-list" class="list-unstyled small"><li class="text-muted">No seats selected</li></ul>
  <p>Total <strong id="sel-total">$0.00</strong></p>
  <form method="post">
   <input type="hidden" asp-for="Seats" id="seats-field" />
   @if (Model.IsStaff)
   {
    <div class="mb-2"><label class="form-label">Passenger username</label><input asp-for="PassengerUsername" class="form-control" required /></div>
    <p class="small text-muted">Counter booking, paid in cash.</p>
   }
   else
   {
    <div class="mb-2"><label class="form-label">Payment method</label>
     <select asp-for="Method" class="form-select"><option value="card">Card</option><option value="cash">Cash</option><option value="bank transfer">Bank transfer</option></select></div>
    <div class="mb-2"><label class="form-label">Loyalty miles: @Model.Miles</label>
     @if (Model.MaxUnits > 0)
     {
      <select asp-for="MilesUnits" class="form-select" id="miles-units">
       <option value="0">Do not use miles</option>
       @for (int u = 1; u <= Model.MaxUnits; u++) { <option value="@u">Use @(u * BookingService.MilesPerDiscount) miles: @(u * BookingService.DiscountPerUnit)% off</option> }
      </select>
     }
     else { <div class="small text-muted">Every @BookingService.MilesPerDiscount miles = @BookingService.DiscountPerUnit% off.</div> }
    </div>
   }
   <button class="btn btn-primary w-100" id="confirm" disabled>Confirm booking</button>
  </form>
 </div></div>
</div>
</div>
@section Scripts {
<script>
 var picked = {};
 var perUnit = @BookingService.DiscountPerUnit;
 function render() {
   var keys = Object.keys(picked), sum = 0, list = document.getElementById('sel-list');
   list.innerHTML = keys.length ? '' : '<li class="text-muted">No seats selected</li>';
   keys.forEach(function (k) { sum += picked[k]; var li = document.createElement('li'); li.textContent = k + ': $' + picked[k].toFixed(2); list.appendChild(li); });
   var m = document.getElementById('miles-units');
   if (m) sum = sum * (1 - parseInt(m.value) * perUnit / 100);
   document.getElementById('sel-total').textContent = '$' + sum.toFixed(2);
   document.getElementById('seats-field').value = keys.join(',');
   document.getElementById('confirm').disabled = keys.length === 0;
 }
 document.getElementById('plane').addEventListener('click', function (e) {
   var s = e.target.closest('.seat'); if (!s || s.classList.contains('taken')) return;
   var k = s.dataset.seat;
   if (picked[k] !== undefined) { delete picked[k]; s.classList.remove('selected'); }
   else if (Object.keys(picked).length < 9) { picked[k] = parseFloat(s.dataset.price); s.classList.add('selected'); }
   render();
 });
 var mu = document.getElementById('miles-units'); if (mu) mu.addEventListener('change', render);
</script>
}
