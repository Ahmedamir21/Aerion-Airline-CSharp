@page
@model AccountModel
@{ ViewData["Title"] = "Miles"; }
<div class="section-panel">
    <h2><i class="fas fa-medal"></i> Loyalty miles</h2>
    <div class="dashboard-stats stat-grid">
        <div class="stat-card"><div class="stat-number">@Model.Balance</div><div class="stat-label">Miles available</div></div>
    </div>
    <p class="muted">Every @BookingService.MilesPerDiscount miles gives @BookingService.DiscountPerUnit% off a booking (up to @(BookingService.MaxDiscountUnits * BookingService.DiscountPerUnit)%).</p>
    <table>
        <thead><tr><th>Date</th><th>Miles</th><th>Reason</th></tr></thead>
        <tbody>
        @foreach (var h in Model.History)
        {
            <tr><td>@h.When.ToString("dd MMM yyyy HH:mm")</td><td>@(h.Miles > 0 ? "+" : "")@h.Miles</td><td>@h.Reason</td></tr>
        }
        </tbody>
    </table>
</div>
